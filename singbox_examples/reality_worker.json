{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "in-vless-reality",
      "listen": "::",
      "listen_port": 443,
      "sniff": true,
      "sniff_override_destination": true,
      "users": [
        {
          "name": "premium",
          "uuid": "<PREMIUM_UUID_1>",
          "flow": "xtls-rprx-vision"
        },
        {
          "name": "free",
          "uuid": "<FREE_UUID_1>",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "telemetry.mozilla.org",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "telemetry.mozilla.org",
            "server_port": 443
          },
          "private_key": "<REALITY_PRIVATE_KEY>",
          "short_id": [
            "<REALITY_SHORT_ID>"
          ]
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "in-hysteria2",
      "listen": "::",
      "listen_port": 8443,
      "users": [
        {
          "name": "premium",
          "password": "<PREMIUM_HY2_PASSWORD>"
        },
        {
          "name": "free",
          "password": "<FREE_HY2_PASSWORD>"
        }
      ],
      "obfs": {
        "type": "salamander",
        "password": "<OBFS_SHARED_PASSWORD>"
      },
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "certificate_path": "/path/to/fullchain.pem",
        "key_path": "/path/to/privkey.pem"
      }
    },
    {
      "type": "tuic",
      "tag": "in-tuic",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "premium",
          "uuid": "<PREMIUM_TUIC_UUID>",
          "password": "<PREMIUM_TUIC_PASSWORD>"
        },
        {
          "name": "free",
          "uuid": "<FREE_TUIC_UUID>",
          "password": "<FREE_TUIC_PASSWORD>"
        }
      ],
      "congestion_control": "bbr",
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "certificate_path": "/path/to/fullchain.pem",
        "key_path": "/path/to/privkey.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "Direct-Premium"
    },
    {
      "type": "direct",
      "tag": "Direct-Free",
      "routing_mark": 100
    },
    {
      "type": "block",
      "tag": "Block"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "Block"
      },
      {
        "user": ["premium"],
        "action": "route",
        "outbound": "Direct-Premium"
      },
      {
        "user": ["free"],
        "action": "route",
        "outbound": "Direct-Free"
      }
    ],
    "final": "Block"
  }
}
